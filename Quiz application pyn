score = 0

questions = [
    ("What is 2 + 2?", "4"),
    ("What is the capital of India?", "delhi"),
    ("Which language are we learning?", "python")
]

for question, answer in questions:
    user_answer = input(question + " ").lower()

    if user_answer == answer:
        print("Correct!")
        score += 1
    else:
        print("Wrong!")

print("Final Score:", score, "/", len(questions))
