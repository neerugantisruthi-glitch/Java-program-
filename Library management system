books = []

while True:
    print("\n1. Add Book")
    print("2. View Books")
    print("3. Borrow Book")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        book = input("Enter book name: ")
        books.append(book)
        print("Book added")

    elif choice == "2":
        if books:
            for book in books:
                print(book)
        else:
            print("No books available")

    elif choice == "3":
        book = input("Enter book name: ")

        if book in books:
            books.remove(book)
            print("Book borrowed")
        else:
            print("Book not available")

    elif choice == "4":
        break

    else:
        print("Invalid choice")
